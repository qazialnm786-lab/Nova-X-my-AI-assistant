<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Orbital Ring -->
    <path
        android:pathData="M54,28 A26,26 0 1,1 53.9,28 Z"
        android:strokeWidth="2.5"
        android:strokeColor="#4D00E5FF"
        android:fillColor="#00000000" />

    <!-- Tilted Gyroscope Orbital Ring -->
    <path
        android:pathData="M29,54 C29,41 40,32 54,32 C68,32 79,41 79,54 C79,67 68,76 54,76 C40,76 29,67 29,54 Z"
        android:strokeWidth="1.8"
        android:strokeColor="#7C4DFF"
        android:fillColor="#00000000" />

    <!-- Central Glowing Core Orb -->
    <path
        android:pathData="M54,54m-16,0a16,16 0 1,0 32,0a16,16 0 1,0 -32,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="42"
                android:startY="42"
                android:endX="66"
                android:endY="66"
                android:type="linear">
                <item android:offset="0.0" android:color="#00E5FF" />
                <item android:offset="0.5" android:color="#7C4DFF" />
                <item android:offset="1.0" android:color="#FF4081" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Core Highlight -->
    <path
        android:pathData="M54,54m-8,0a8,8 0 1,0 16,0a8,8 0 1,0 -16,0"
        android:fillColor="#FFFFFF" />

    <!-- Soundwave / Energy Beams (Microphone Voice Pulse) -->
    <path
        android:pathData="M23,54 L27,54 M81,54 L85,54 M54,23 L54,27 M54,81 L54,85"
        android:strokeWidth="2.5"
        android:strokeColor="#00E5FF"
        android:strokeLineCap="round" />

    <!-- Corner Sparkles for NOVA -->
    <path
        android:pathData="M33,37 L35,37 M34,36 L34,38 M74,71 L76,71 M75,70 L75,72"
        android:strokeWidth="1.5"
        android:strokeColor="#00E5FF"
        android:strokeLineCap="round" />
</vector>

